# F-Guard 환경 변수 예시 — 이 파일을 .env 로 복사해 값을 채우세요. (.env 는 git 에 커밋하지 않습니다)
# 백엔드는 프로젝트 루트의 .env 를 자동으로 읽습니다. 값이 비어 있으면 해당 기능은 MOCK/수동 모드로 동작합니다.

# --- PostgreSQL ---
DB_URL=jdbc:postgresql://localhost:5432/fguard
DB_USERNAME=fguard
DB_PASSWORD=fguard

# --- OpenAI GPT API (비어 있으면 MOCK) ---
# 모델명은 https://platform.openai.com/docs/models 에서 PDF·이미지 입력과 Structured Outputs 를 지원하는 모델을 확인해 입력하세요.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=
OPENAI_TEXT_MODEL=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_TIMEOUT_SECONDS=90

# --- 기상청 단기예보 (공공데이터포털 '기상청_단기예보 조회서비스', 일반 인증키 Decoding 값) ---
KMA_SERVICE_KEY=

# --- 카카오모빌리티 길찾기 REST 키 (선택, 자동차 경로) ---
KAKAO_MOBILITY_REST_KEY=

# --- Google OAuth (Google Cloud Console > OAuth 클라이언트 ID, 웹 애플리케이션) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/calendar/google/callback

# --- 프론트엔드 주소 (OAuth 콜백 후 돌아갈 곳, CORS 허용) ---
FRONTEND_URL=http://localhost:5173
